# Tradesman Finance - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# RESEND (Required for form submissions — set in Netlify, never commit)
# ===========================================
# Same structure as the property-finance sites. /api/lead emails every form
# submission via Resend. Free-tier Resend with onboarding@resend.dev only
# delivers to the account owner's inbox; verify a domain to change RESEND_FROM.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_TO=commercialmortgagesbroker@gmail.com
# RESEND_FROM=Tradesman Finance <onboarding@resend.dev>

# ===========================================
# ZAPIER WEBHOOK (Optional extra forward for form submissions)
# ===========================================
# 1. Go to https://zapier.com
# 2. Create new Zap → Webhooks by Zapier → Catch Hook
# 3. Copy the webhook URL here
NEXT_PUBLIC_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXX/XXXXXX/

# ===========================================
# CLERK AUTHENTICATION (Optional - for admin)
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# ===========================================
# CONVEX DATABASE (Optional - for future use)
# ===========================================
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
